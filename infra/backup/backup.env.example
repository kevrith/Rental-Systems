# Copy to backup.env, fill in real values, then: chmod 600 backup.env
# backup.env is git-ignored. Never commit it.

# --- Database --------------------------------------------------------------
# Any libpq URL. The scripts strip a SQLAlchemy "+driver" suffix, so the value
# from backend/.env works as-is.
BACKUP_DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>

# --- Where dumps land ------------------------------------------------------
BACKUP_DIR=/var/backups/rentflow
BACKUP_LABEL=rentflow-prod

# --- Retention (grandfather-father-son) ------------------------------------
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# --- Offsite copy on Cloudflare R2 -----------------------------------------
# Leave BACKUP_R2_BUCKET blank and the dump stays on this machine only.
# Use a bucket and API token separate from the app's file storage.
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=backups/postgres
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Override only to use a different S3-compatible provider (or a local S3 in a
# test). Defaults to the R2 endpoint for R2_ACCOUNT_ID.
# BACKUP_S3_ENDPOINT=

# --- Encryption at rest (optional, recommended for production) -------------
# Key id or email of a GPG *public* key. The private key must NOT live on this
# server: the box should be able to write backups it cannot read back.
BACKUP_GPG_RECIPIENT=

# --- Dead-man's-switch (optional) ------------------------------------------
# Pinged only on success. If pings stop, the monitor alerts you.
BACKUP_HEARTBEAT_URL=

# --- Local development only ------------------------------------------------
# Run pg_dump inside the compose Postgres container so the client version
# always matches the server, and nothing has to be installed on the host.
# BACKUP_DOCKER_SERVICE=postgres
