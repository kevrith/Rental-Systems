# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true
# The real frontend origin in production — used to build links this backend
# sends out (email verification, password reset, tenant portal invites,
# magic links). Wrong value here means a correct-looking email with a link
# that 404s.
FRONTEND_URL=http://localhost:5173
# Shown in customer-facing emails/messages (data export notices, the
# security-questionnaire template, etc.) — set to a real, monitored inbox
# before going live.
SUPPORT_EMAIL=support@rentflow.co.ke

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-value

# --- Google Sign-In ---
# OAuth client ID from https://console.cloud.google.com/apis/credentials — not
# a secret, it's shared with the frontend too (VITE_GOOGLE_CLIENT_ID). Leave
# blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>
DATABASE_URL_SYNC=postgresql+psycopg2://<db_user>:<db_password>@localhost:5432/<db_name>

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated list is parsed by pydantic-settings as JSON array or repeat env var) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Object storage (Cloudflare R2, S3-compatible) ---
# Blank locally — storage silently falls back to local disk
# (LOCAL_STORAGE_DIR), which is fine for dev but means nothing survives a
# redeploy and nothing is reachable from more than one machine. Production
# must set all four of the first ones, or every upload endpoint is writing to
# a disk that isn't backed up. Create a bucket + API token in the Cloudflare
# dashboard (R2 > Manage API tokens) to get these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public/custom domain, used to build download URLs. Leave
# blank to use R2's own generated endpoint.
R2_PUBLIC_BASE_URL=
# Only for a store that is not Cloudflare R2 — Supabase Storage, MinIO, plain
# S3. Set it and the account id above becomes unnecessary, addressing switches
# to path style, and R2_REGION must name the store's real region ("auto" is an
# R2-ism). Supabase Storage's endpoint is on its dashboard under
# Storage > Settings > S3 connection, together with the region.
R2_ENDPOINT_URL=
R2_REGION=auto

# --- Third-party integrations (leave blank until you have real credentials) ---
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# M-Pesa collections (STK push) — every field below is required for a real
# payment to go through; CONSUMER_KEY/SECRET alone only gets you an access
# token, not a working checkout. DARAJA_CALLBACK_BASE_URL must be a URL
# Safaricom's servers can reach, so it can never be localhost outside their
# own sandbox tooling.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENVIRONMENT=sandbox
DARAJA_CALLBACK_BASE_URL=http://localhost:8000

# M-Pesa B2C (paying an owner out, US-041) — a separate credential set from
# collections. SECURITY_CREDENTIAL is Safaricom's RSA-encrypted initiator
# password, not the plain password itself; Safaricom's Daraja portal
# generates it from your initiator password and their public certificate.
DARAJA_B2C_SHORTCODE=
DARAJA_B2C_INITIATOR_NAME=
DARAJA_B2C_SECURITY_CREDENTIAL=

RESEND_API_KEY=
EMAIL_FROM=RentFlow <noreply@rentflow.co.ke>
# From the Resend dashboard's webhook settings, starts with whsec_ — see
# docs/procurement/email-deliverability.md
RESEND_WEBHOOK_SECRET=

# Web Push (US-030) — the caretaker/tenant PWA's push notifications. Blank
# means push notifications are silently a no-op. Generate a keypair with:
# npx web-push generate-vapid-keys (or `vapid --gen` if that CLI is on PATH).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rentflow.co.ke

# AI lease analysis (Sprint 22) — leave blank to disable; the analyze endpoint
# returns a clear 503 instead of a stack trace.
ANTHROPIC_API_KEY=

# Accounting software sync (Sprint 23) — leave blank to disable; the connect
# endpoint returns a clear 503 instead of starting a broken OAuth flow.
# Must be a URL Intuit/Xero can actually redirect a browser back to.
OAUTH_CALLBACK_BASE_URL=http://localhost:8000
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Virus scanning on upload (Sprint 25) — leave CLAMAV_HOST blank to disable;
# uploads are marked SKIPPED rather than blocked.
CLAMAV_HOST=
CLAMAV_PORT=3310

# WebAuthn / biometric login (Sprint 25). RP_ID must be the bare domain the
# browser is served from (no scheme/port); ORIGIN is the full scheme+host.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RentFlow
WEBAUTHN_ORIGIN=http://localhost:5173

# Error tracking (Sprint 26) — leave blank to disable. Nothing is sent to
# Sentry without a DSN, and personal data is scrubbed before anything is.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Application rate limiting (Sprint 26). Per minute, per user when
# authenticated and per IP otherwise. Set RATE_LIMIT_ENABLED=false only if
# something in front of this API is already doing the same job.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20

# Observability (Sprint 26 enterprise pass).
#
# Structured logs: "console" (human-readable, the default) or "json" — set
# json in any environment whose logs are read by an aggregator rather than a
# terminal.
LOG_FORMAT=console

# Distributed tracing — leave blank to disable. Points at an OTLP/HTTP
# collector: `docker compose -f docker-compose.yml -f infra/observability/docker-compose.yml up`
# runs one locally (Jaeger, UI at http://localhost:16686).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Prometheus metrics at /metrics. Blank leaves it unauthenticated, which is
# fine for a local scrape and unsafe for a public droplet — production must
# set this and give the same value to Prometheus as a bearer token
# (infra/observability/prometheus.yml).
METRICS_TOKEN=

# --- Super admin bootstrap (scripts/create_superadmin.py) ---
# The first `is_platform_staff` account — RentFlow's own team, not a customer.
# Nothing in the API can grant this flag, so the script is the only way in.
# Read once at bootstrap; nothing reads them at runtime, so they can be removed
# again afterwards. Password must be 8-72 bytes (bcrypt's limit), and the phone
# number must be reachable by SMS — login sends an OTP to it.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_PHONE=
SUPERADMIN_NAME=RentFlow Super Admin
SUPERADMIN_ORG_NAME=RentFlow Platform
# Set to true only to overwrite an existing super admin's password on a re-run.
SUPERADMIN_RESET_PASSWORD=false
