# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-value

# --- Database ---
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>
DATABASE_URL_SYNC=postgresql+psycopg2://<db_user>:<db_password>@localhost:5432/<db_name>

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated list is parsed by pydantic-settings as JSON array or repeat env var) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Third-party integrations (leave blank until you have real credentials) ---
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
WHATSAPP_API_TOKEN=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
RESEND_API_KEY=
EMAIL_FROM=RentFlow <noreply@rentflow.co.ke>
