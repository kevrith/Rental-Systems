# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-value

# --- Database ---
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>
DATABASE_URL_SYNC=postgresql+psycopg2://<db_user>:<db_password>@localhost:5432/<db_name>

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated list is parsed by pydantic-settings as JSON array or repeat env var) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Third-party integrations (leave blank until you have real credentials) ---
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
WHATSAPP_API_TOKEN=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
RESEND_API_KEY=
EMAIL_FROM=RentFlow <noreply@rentflow.co.ke>
# From the Resend dashboard's webhook settings, starts with whsec_ — see
# docs/procurement/email-deliverability.md
RESEND_WEBHOOK_SECRET=

# AI lease analysis (Sprint 22) — leave blank to disable; the analyze endpoint
# returns a clear 503 instead of a stack trace.
ANTHROPIC_API_KEY=

# Accounting software sync (Sprint 23) — leave blank to disable; the connect
# endpoint returns a clear 503 instead of starting a broken OAuth flow.
# Must be a URL Intuit/Xero can actually redirect a browser back to.
OAUTH_CALLBACK_BASE_URL=http://localhost:8000
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Virus scanning on upload (Sprint 25) — leave CLAMAV_HOST blank to disable;
# uploads are marked SKIPPED rather than blocked.
CLAMAV_HOST=
CLAMAV_PORT=3310

# WebAuthn / biometric login (Sprint 25). RP_ID must be the bare domain the
# browser is served from (no scheme/port); ORIGIN is the full scheme+host.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RentFlow
WEBAUTHN_ORIGIN=http://localhost:5173

# Error tracking (Sprint 26) — leave blank to disable. Nothing is sent to
# Sentry without a DSN, and personal data is scrubbed before anything is.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Application rate limiting (Sprint 26). Per minute, per user when
# authenticated and per IP otherwise. Set RATE_LIMIT_ENABLED=false only if
# something in front of this API is already doing the same job.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20

# Observability (Sprint 26 enterprise pass).
#
# Structured logs: "console" (human-readable, the default) or "json" — set
# json in any environment whose logs are read by an aggregator rather than a
# terminal.
LOG_FORMAT=console

# Distributed tracing — leave blank to disable. Points at an OTLP/HTTP
# collector: `docker compose -f docker-compose.yml -f infra/observability/docker-compose.yml up`
# runs one locally (Jaeger, UI at http://localhost:16686).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Prometheus metrics at /metrics. Blank leaves it unauthenticated, which is
# fine for a local scrape and unsafe for a public droplet — production must
# set this and give the same value to Prometheus as a bearer token
# (infra/observability/prometheus.yml).
METRICS_TOKEN=
